{
  "$description": "Volta design tokens, extracted from the design canvas (artboard design-system). Mirrored in src/app/globals.css. `designName` is the name used in the canvas and in conversations with the design team.",
  "color": {
    "forest": { "$value": "#143A28", "designName": "Mata", "$description": "Decision panels, dark button, emphasis text" },
    "forest-deep": { "$value": "#0E2A1D", "designName": "Mata escura", "$description": "Dark button hover" },
    "ember": { "$value": "#CC4A14", "designName": "Brasa", "$description": "Primary action only, one per screen. White on it: 4.6:1" },
    "ember-deep": { "$value": "#B23F10", "designName": "Brasa escura", "$description": "Primary action hover" },
    "sprout": { "$value": "#CFE57A", "designName": "Broto", "$description": "Data and highlights on forest. Never on light backgrounds" },
    "paper": { "$value": "#F5F6F1", "designName": "Papel", "$description": "Screen background" },
    "surface": { "$value": "#FFFFFF", "designName": "Superfície", "$description": "Cards" },
    "well": { "$value": "#F1F3EE", "designName": "Poço", "$description": "Light area inside cards (offer, KPIs)" },
    "border": { "$value": "#E3E6DF", "designName": "Linha", "$description": "Card borders" },
    "border-soft": { "$value": "#ECEEE9", "designName": "Linha suave", "$description": "Inner dividers and bar tracks" },
    "border-input": { "$value": "#C9D0C6", "designName": "Borda de campo", "$description": "Inputs and ghost button" },
    "ink": { "$value": "#14231B", "designName": "Tinta", "$description": "Primary text" },
    "graphite": { "$value": "#4D5B53", "designName": "Grafite", "$description": "Secondary text" },
    "peach": { "$value": "#FCE6D4", "designName": "Pêssego", "$description": "Draft shortcut and warnings" },
    "peach-ink": { "$value": "#5A2306", "designName": "Texto sobre pêssego" },
    "leaf": { "$value": "#DDEBC4", "designName": "Folha", "$description": "Results shortcut" },
    "mint": { "$value": "#E2F0DC", "designName": "Menta", "$description": "Confirmations" },
    "mint-ink": { "$value": "#173F27", "designName": "Texto sobre menta" },
    "chart-primary": { "$value": "#2E7D50", "$description": "Main chart series" },
    "chart-secondary": { "$value": "#E0702F", "$description": "Secondary series. Always direct-labeled (pair is close under protanopia)" },
    "chart-rest": { "$value": "#DDE2DA", "$description": "Remainder of a whole" }
  },
  "status": {
    "draft": { "background": { "$value": "#ECEEE9" }, "text": { "$value": "#3F4A43" }, "designName": "Rascunho" },
    "pending": { "background": { "$value": "#FCE6D4" }, "text": { "$value": "#8A3209" }, "designName": "Pendente" },
    "active": { "background": { "$value": "#E2F0DC" }, "text": { "$value": "#1F5A35" }, "designName": "Ativa" },
    "closed": { "background": { "$value": "#ECE7F5" }, "text": { "$value": "#4B3A73" }, "designName": "Encerrada" },
    "paused": { "background": { "$value": "#FFF1C7" }, "text": { "$value": "#6B4D00" }, "designName": "Pausada" }
  },
  "font": {
    "heading": { "$value": "'Bricolage Grotesque', 'Figtree', system-ui, sans-serif", "$description": "Weights 500–700, letter-spacing -0.02em" },
    "body": { "$value": "'Figtree', system-ui, -apple-system, 'Segoe UI', sans-serif", "$description": "Weights 400–700. Tabular numbers in tables and totals" }
  },
  "radius": {
    "field": { "$value": "12px" },
    "well": { "$value": "14px" },
    "card": { "$value": "20px" },
    "panel": { "$value": "28px", "$description": "Forest decision panels on desktop. 24px on mobile" },
    "pill": { "$value": "999px", "$description": "Buttons, chips and filters" }
  },
  "size": {
    "button-height": { "$value": "48px" },
    "min-touch-target": { "$value": "44px" },
    "content-max-width": { "$value": "1240px" }
  }
}
