# Copy to .env.local and fill in. Never commit .env.local.

# Public URL of the app (used by the OAuth redirect and SSO)
APP_URL=http://localhost:3000

# Demo mode: labeled synthetic data, no calls to Cardápio Web
DEMO_MODE=true

# --- Cardápio Web (CW App Store) ---
# sandbox | production
CW_ENVIRONMENT=sandbox
# Sent by CW support when the app is registered (integracao@cardapioweb.com)
CW_CLIENT_ID=
CW_REDIRECT_URI=http://localhost:3000/api/cw/oauth/callback
# Authenticates order webhooks (X-Webhook-Token) and signs billing webhooks (HMAC)
CW_WEBHOOK_TOKEN=

# --- Supabase ---
SUPABASE_URL=
# Server only. Never expose it with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
# Database password of the remote project. Used only by the Supabase CLI (link, db push).
SUPABASE_DB_PASSWORD=

# --- Security ---
# 32 random bytes in base64, used to encrypt CW tokens at rest: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Signs the session cookie: openssl rand -base64 32
SESSION_SECRET=
# Required by /api/cron/* as "Authorization: Bearer <value>"
CRON_SECRET=
